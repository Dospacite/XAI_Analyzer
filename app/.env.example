# Required services
HF_TOKEN=hf_replace_me
QWEN_API_KEY=replace_me
QWEN_BASE_URL=https://example.openai.azure.com/v1
QWEN_MODEL=qwen3.5-flash

# Application
SQLITE_PATH=/data/traceguard.sqlite3
SCRAPER_TOKEN=replace-with-a-long-random-value
SCRAPER_URL=http://scraper:8081
PUBLIC_APP_URL=http://localhost:3000

# Public model repositories
HF_QWEN_REPO_ID=Dospacite/xai-phishing-qwen3-4b-merged
HF_LLAMA_REPO_ID=Dospacite/xai-phishing-llama-3.1-8b-merged
HF_DEEPSEEK_REPO_ID=Dospacite/xai-phishing-deepseek-r1-qwen-7b-merged
HF_GEMMA_REPO_ID=Dospacite/gemma4-e4b-unsloth-phishing-merged

# Dedicated Hugging Face Inference Endpoint URLs.
# Leave blank to show a clear "endpoint not configured" result in the UI.
HF_QWEN_ENDPOINT_URL=
HF_LLAMA_ENDPOINT_URL=
HF_DEEPSEEK_ENDPOINT_URL=
HF_GEMMA_ENDPOINT_URL=

HF_ENDPOINT_NAMESPACE=Dospacite
HF_MANAGE_ENDPOINT_LIFECYCLE=true
HF_ENDPOINT_START_TIMEOUT_SECONDS=900
HF_ENDPOINT_POLL_SECONDS=10
HF_QWEN_ENDPOINT_NAME=traceguard-qwen3-4b
HF_LLAMA_ENDPOINT_NAME=traceguard-llama-3-1-8b
HF_DEEPSEEK_ENDPOINT_NAME=traceguard-deepseek-r1-qwen-7b
HF_GEMMA_ENDPOINT_NAME=traceguard-gemma4-e4b

# Optional defaults used by scripts/setup_hf_endpoints.py when creating
# dedicated Hugging Face Inference Endpoints.
HF_ENDPOINT_VENDOR=aws
HF_ENDPOINT_REGION=us-east-1
HF_ENDPOINT_ACCELERATOR=gpu
HF_ENDPOINT_FRAMEWORK=pytorch
HF_ENDPOINT_TASK=text-generation
HF_ENDPOINT_TYPE=protected
HF_ENDPOINT_MIN_REPLICA=1
HF_ENDPOINT_MAX_REPLICA=1

# Optional per-model hardware overrides for endpoint creation.
HF_QWEN_ENDPOINT_INSTANCE_TYPE=nvidia-l4
HF_QWEN_ENDPOINT_INSTANCE_SIZE=x1
HF_LLAMA_ENDPOINT_INSTANCE_TYPE=nvidia-l40s
HF_LLAMA_ENDPOINT_INSTANCE_SIZE=x1
HF_DEEPSEEK_ENDPOINT_INSTANCE_TYPE=nvidia-l4
HF_DEEPSEEK_ENDPOINT_INSTANCE_SIZE=x1
HF_GEMMA_ENDPOINT_INSTANCE_TYPE=nvidia-l40s
HF_GEMMA_ENDPOINT_INSTANCE_SIZE=x1
